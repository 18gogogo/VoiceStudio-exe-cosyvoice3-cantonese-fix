+#: CosyVoice 3 ships no language-tag tokens (``<|yue|>`` is not in its vocab),
+#: so the ONLY way to steer the spoken variety is the instruct string -- the way
+#: upstream's own Cantonese example does it. Simplified-Chinese phrasing is
+#: deliberate: A/B tests on the real model showed ``请用广东话表达`` was the only
+#: variant that reliably produced Cantonese. Adding ``香港`` or switching to
+#: ``粤语`` both flipped the output back to Mandarin (and Traditional-Chinese
+#: spelling of the instruction collapsed to a 0.2s clip).
+_LANG_INSTRUCT = {
+    "yue": "请用广东话表达",
+}
 
