+def _lang_instruct(language) -> str:
+    """Language-variety instruct for v3 (which has no language tokens)."""
+    if not language:
+        return ""
+    full = str(language).lower()
+    return _LANG_INSTRUCT.get(full) or _LANG_INSTRUCT.get(full[:2], "")
+
